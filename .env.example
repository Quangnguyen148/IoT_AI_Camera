# ==============================================================================
# 1. CẤU HÌNH COREIOT CLOUD (TV3 - Cloud Platform & Automation Setup)
# ==============================================================================
# Thông tin tài khoản CoreIOT (dùng cho script setup tools/coreiot_setup.py – KHÔNG commit file .env thật)
COREIOT_URL=https://app.coreiot.io
COREIOT_USERNAME=email_cua_ban@hcmut.edu.vn
COREIOT_PASSWORD=

# Cấu hình kết nối MQTT Broker CoreIOT Cloud
COREIOT_HOST=app.coreiot.io
COREIOT_PORT=1883
GATEWAY_NAME=BTL_PC_GATEWAY
DEVICE_NAME=Camera_AI_01
GATEWAY_ACCESS_TOKEN=YOUR_COREIOT_GATEWAY_ACCESS_TOKEN

# ==============================================================================
# 2. CẤU HÌNH GATEWAY & AI (TV1: Edge AI YOLOv8 + Gemini LLM & TV2: Gateway Service)
# ==============================================================================
# Google Gemini API (phân tích bối cảnh và sinh cảnh báo ngôn ngữ tự nhiên)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.0-flash

# Cấu hình thị giác máy tính & cơ chế chống nhiễu
YOLO_MODEL_PATH=yolov8n.pt
CAMERA_INDEX=0
CONF_THRESHOLD=0.6
QUARANTINE_FRAMES=15
CAUSAL_WINDOW_SEC=5.0

# ==============================================================================
# 3. CẤU HÌNH LOCAL WEBSERVER & STREAMLIT (TV2: Local Monitoring, MJPEG & Hot-Reload)
# ==============================================================================
WEBSERVER_HOST=0.0.0.0
WEBSERVER_PORT=8000
